# Shared geometry and lighting for the photon-map caustic comparison.
# The enclosing scene file chooses the integrator and output resolution.

WorldBegin

# Diffuse room, open toward the camera.
AttributeBegin
    Material "diffuse" "rgb reflectance" [ 0.82 0.82 0.82 ]
    Shape "trianglemesh"
        "point3 P" [ -4 0 -4   4 0 -4   4 0 4   -4 0 4 ]
        "integer indices" [ 0 1 2  2 3 0 ]
AttributeEnd

AttributeBegin
    Material "diffuse" "rgb reflectance" [ 0.68 0.72 0.80 ]
    Shape "trianglemesh"
        "point3 P" [ -4 0 -4   4 0 -4   4 3.5 -4   -4 3.5 -4 ]
        "integer indices" [ 0 1 2  2 3 0 ]
AttributeEnd

AttributeBegin
    Material "diffuse" "rgb reflectance" [ 0.78 0.18 0.14 ]
    Shape "trianglemesh"
        "point3 P" [ -4 0 4   -4 0 -4   -4 3.5 -4   -4 3.5 4 ]
        "integer indices" [ 0 1 2  2 3 0 ]
AttributeEnd

AttributeBegin
    Material "diffuse" "rgb reflectance" [ 0.16 0.68 0.20 ]
    Shape "trianglemesh"
        "point3 P" [ 4 0 -4   4 0 4   4 3.5 4   4 3.5 -4 ]
        "integer indices" [ 0 1 2  2 3 0 ]
AttributeEnd

# A glass sphere focuses the area light into a caustic on the floor.
AttributeBegin
    Translate 0 0.72 0.15
    Material "dielectric" "float eta" [ 1.5 ]
    Shape "sphere" "float radius" [ 0.48 ]
AttributeEnd

# Diffuse objects make the global-illumination contribution visible too.
AttributeBegin
    Translate 1.45 0.50 -0.75
    Material "diffuse" "rgb reflectance" [ 0.72 0.62 0.30 ]
    Shape "sphere" "float radius" [ 0.50 ]
AttributeEnd

AttributeBegin
    Translate -1.35 0.38 0.70
    Material "diffuse" "rgb reflectance" [ 0.28 0.42 0.76 ]
    Shape "sphere" "float radius" [ 0.38 ]
AttributeEnd

# Compact spherical area light above the glass sphere.
AttributeBegin
    Translate 0 2.85 0.15
    AreaLightSource "diffuse" "rgb L" [ 18 18 18 ]
    Shape "sphere" "float radius" [ 0.32 ]
AttributeEnd
